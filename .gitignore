# Pythonが自動生成するバイトコード。
# ソースから作り直せるうえ、Pythonのバージョンが変わると
# 別名のファイル(cpython-311 / cpython-312 …)が増え続けるので追跡しない。
__pycache__/
*.py[cod]

# 実行時データはユーザー別ローカル領域(%LOCALAPPDATA%)に置く方針なので、
# ふつうはリポジトリに現れない。手元で環境変数を差し替えて試したときの
# 取りこぼしを防ぐための保険。
logs/
*.log
*.db
*.db-wal
*.db-shm

# 現場の配布設定 (管理者パスワードの指紋を含む)。製品のリポジトリには入れない
config/distribution.json
config/distribution.json.tmp
